<?xml version="1.0" encoding="utf-8"?>
<!--
    the robify mark as the icon for the notification.

    android draws the small icon of a notification as an outline alone: the
    colour comes from the system and the alpha mask is what is left. the
    launcher icon of the app does not do for it, its surface is opaque and
    would come out as a white square. this version is a silhouette out of the
    box, the same drawing as `icons/robify-logo.svg`, only in the notation
    android knows for vectors: no rectangles, no ellipses, paths alone.

    it lives here and not under `gen/android` because that directory is
    created anew at every `tauri android init`, and it is put in by
    scripts/android-nachruesten.mjs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <!-- moves the drawing into the middle of the field and scales it up, as in the svg. -->
    <group android:translateX="256" android:translateY="256">
        <group android:scaleX="1.45" android:scaleY="1.45">
            <group android:translateX="-204" android:translateY="-288">
                <!-- the beam over both stems, rising. -->
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M150,214 L338,166 v52 L150,266 z" />
                <!-- the stems, as a path instead of a rectangle. -->
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M150,214 h26 v150 h-26 z" />
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M312,172.64 h26 v143.36 h-26 z" />
                <!-- the note heads, tilted as in musical notation. a circle
                     of two half arcs, the format knows no ellipse. -->
                <group
                    android:pivotX="120"
                    android:pivotY="366"
                    android:rotation="-20">
                    <path
                        android:fillColor="#FFFFFFFF"
                        android:pathData="M68,366 a52,40 0 1,0 104,0 a52,40 0 1,0 -104,0 z" />
                </group>
                <group
                    android:pivotX="282"
                    android:pivotY="318"
                    android:rotation="-20">
                    <path
                        android:fillColor="#FFFFFFFF"
                        android:pathData="M230,318 a52,40 0 1,0 104,0 a52,40 0 1,0 -104,0 z" />
                </group>
            </group>
        </group>
    </group>
</vector>
