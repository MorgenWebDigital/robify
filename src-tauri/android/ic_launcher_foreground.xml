<?xml version="1.0" encoding="utf-8"?>
<!--
    the foreground of the launcher icon.

    the same drawing as `icons/robify-logo.svg`, in the build of the buttons
    in the app: a surface with a gradient from light to dark and a hard edge
    below it that lifts the mark off the surface. a soft shadow would not
    work, vectors in android know none, so the depth comes from the drawing
    standing there twice, the lower one offset by 2.4 units and darker.

    the background is transparent. the white disc under it turned the mark
    into a badge on a plate, and without it the mark stands free on the home
    screen, as the icons next to it do.

    android cuts a launcher icon into the shape the user has set. only the
    inner circle of 72 of the 108 units stays reliably visible, and the
    drawing is centred on its middle and scaled down far enough for the offset
    edge to stay inside it too.

    the coordinates stand calculated out instead of in nested groups: nested,
    the note heads came out as dots and the beam as a slab.

    it lives here and not under `gen/android` because that directory is
    created anew at every `tauri android init`, and it is put in by
    scripts/android-nachruesten.mjs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- the edge below it, the same drawing offset. -->
    <path
        android:fillColor="#FF6E6E78"
        android:pathData="M44.918,44.072 L76.757,35.943 L76.757,44.75 L44.918,52.879 z" />
    <path
        android:fillColor="#FF6E6E78"
        android:pathData="M44.918,44.072 L49.321,44.072 L49.321,69.476 L44.918,69.476 z" />
    <path
        android:fillColor="#FF6E6E78"
        android:pathData="M72.354,37.068 L76.757,37.068 L76.757,61.347 L72.354,61.347 z" />
    <path
        android:fillColor="#FF6E6E78"
        android:pathData="M31.561,72.827 a8.807,6.774 -20 1,0 16.551,-6.024 a8.807,6.774 -20 1,0 -16.551,6.024 z" />
    <path
        android:fillColor="#FF6E6E78"
        android:pathData="M58.997,64.697 a8.807,6.774 -20 1,0 16.551,-6.024 a8.807,6.774 -20 1,0 -16.551,6.024 z" />

    <!-- the surface over it, with a gradient from top to bottom. -->
    <!-- the beam over both stems, rising. -->
    <path android:pathData="M44.918,41.672 L76.757,33.543 L76.757,42.35 L44.918,50.479 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="33.543"
                android:endX="54" android:endY="74.457"
                android:startColor="#FFD5D5DC"
                android:endColor="#FF9C9CA8" />
        </aapt:attr>
    </path>
    <!-- the left stem. -->
    <path android:pathData="M44.918,41.672 L49.321,41.672 L49.321,67.076 L44.918,67.076 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="33.543"
                android:endX="54" android:endY="74.457"
                android:startColor="#FFD5D5DC"
                android:endColor="#FF9C9CA8" />
        </aapt:attr>
    </path>
    <!-- the right stem. -->
    <path android:pathData="M72.354,34.668 L76.757,34.668 L76.757,58.947 L72.354,58.947 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="33.543"
                android:endX="54" android:endY="74.457"
                android:startColor="#FFD5D5DC"
                android:endColor="#FF9C9CA8" />
        </aapt:attr>
    </path>
    <!-- the left note head, tilted as in musical notation. -->
    <path android:pathData="M31.561,70.427 a8.807,6.774 -20 1,0 16.551,-6.024 a8.807,6.774 -20 1,0 -16.551,6.024 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="33.543"
                android:endX="54" android:endY="74.457"
                android:startColor="#FFD5D5DC"
                android:endColor="#FF9C9CA8" />
        </aapt:attr>
    </path>
    <!-- the right note head. -->
    <path android:pathData="M58.997,62.297 a8.807,6.774 -20 1,0 16.551,-6.024 a8.807,6.774 -20 1,0 -16.551,6.024 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="33.543"
                android:endX="54" android:endY="74.457"
                android:startColor="#FFD5D5DC"
                android:endColor="#FF9C9CA8" />
        </aapt:attr>
    </path>
</vector>
